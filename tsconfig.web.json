{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/frontend/**/*", "src/shared/**/*"],
  "exclude": ["src/backend/**/*"]
}
