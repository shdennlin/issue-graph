# issue-graph quick-start configuration.
#
# Copy to .env and fill LINEAR_API_KEY. Everything else has a default.

# Required: Linear → Settings → API → Create Personal API Key
LINEAR_API_KEY=

# Optional: restrict sync to one Linear team. Empty = all accessible teams.
# LINEAR_TEAM_ID=

# Optional: enable design-doc progress by pointing at a repo containing
# openspec/changes/*/{proposal.md,tasks.md}. Must be an absolute path.
# REPO_PATH=/absolute/path/to/your/repo

# Optional: multiple Linear workspace profiles.
# Keep this whole block commented unless you need to switch between workspaces.
# Details: docs/advanced-workspaces.md
#
# WORKSPACE_ACTIVE=personal
#
# WORKSPACE_PERSONAL_NAME=Personal
# WORKSPACE_PERSONAL_LINEAR_API_KEY=lin_api_xxx
# WORKSPACE_PERSONAL_LINEAR_TEAM_ID=
# WORKSPACE_PERSONAL_REPO_PATH=/absolute/path/to/personal/repo
#
# WORKSPACE_CLIENT_A_NAME=Client A
# WORKSPACE_CLIENT_A_LINEAR_API_KEY=lin_api_yyy
# WORKSPACE_CLIENT_A_LINEAR_TEAM_ID=
# WORKSPACE_CLIENT_A_REPO_PATH=/absolute/path/to/client-a/repo

# Advanced:
# - Custom label schema: label-schema.example.yaml
# - Storage, cache, UI defaults, and backend tuning are optional; see
#   src/backend/lib/env.ts for the current defaults.
