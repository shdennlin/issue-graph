# issue-graph configuration. Copy to .env and fill in.
# All variables documented in PRD §10.1.

# ─── Backend selection ───────────────────────────────────────
BACKEND=linear

# ─── Linear backend (required when BACKEND=linear) ───────────
LINEAR_API_KEY=                          # from Linear → Settings → API
LINEAR_API_ENDPOINT=                     # empty = official api.linear.app/graphql
LINEAR_WORKSPACE=                        # workspace slug if API key has multi-workspace access
LINEAR_TEAM_ID=                          # empty = all teams accessible to API key

# ─── Server (no prefix) ──────────────────────────────────────
PORT=31415
INSTANCE_LABEL=personal-local
LOG_LEVEL=info
LOG_TO_FILE=false

# ─── Storage ─────────────────────────────────────────────────
SQLITE_PATH=/app/data/graph.db
REPO_PATH=/repo
LABEL_SCHEMA_PATH=/app/data/label-schema.yaml

# ─── Issue scope ─────────────────────────────────────────────
ISSUE_SCOPE=active+recent

# ─── Label schema ────────────────────────────────────────────
PRIMARY_GROUP=
TYPE_GROUP=
TYPE_ICONS=

# ─── Cache & data retention ──────────────────────────────────
CACHE_TTL_SECONDS=900
DAILY_SNAPSHOT_HOUR=2
SNAPSHOT_RETENTION_DAYS=365
SYNC_LOG_RETENTION=forever

# ─── Design-doc integration ──────────────────────────────────
DESIGNDOC_ADAPTER=auto
DESIGNDOC_REQUIRED=false

# ─── UI defaults ─────────────────────────────────────────────
STALE_DAYS=14
DEFAULT_VIEW=dependency
DEFAULT_THEME=auto
NODE_DENSITY=default
SHOW_ACTIVE_ONLY_DEFAULT=true
