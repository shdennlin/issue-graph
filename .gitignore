# Dependencies
node_modules/

# Build outputs
build/
dist/

# Runtime data (SQLite, snapshots, logs) — never committed.
# data-dev/ is the host-only dev tree, kept disjoint from data/ (used by
# the docker container) so concurrent SQLite writes don't corrupt the WAL.
data/
data-dev/

# Env files (never committed)
.env
.env.local
.env.*.local
!.env.example
.envrc
docker-compose.override.yml

# Logs
*.log
npm-debug.log*

# Bun
.bun/
bun.lockb.bak

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Misc
*.pid
.tmp/
*.tsbuildinfo

# Linked worktrees (created via `git worktree add .worktree/<branch>`)
.worktree/
